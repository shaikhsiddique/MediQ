PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/mediq
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
CLIENT_URL=http://localhost:5173
# Public base URL for saved report PDFs (used in documentUrl on patient profile)
API_PUBLIC_URL=http://localhost:4000

# Local AI (Ollama) — required for chat and report analysis
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Twilio — optional, for Guardian SMS alerts
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
PARENT_PHONE_NUMBER=+91xxxxxxxxxx
